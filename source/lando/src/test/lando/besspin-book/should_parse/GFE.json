                                                "line": 37,
                                                "col": 0
                                            },
                                            "text": "definitely comment some of these out"
                                        },
                                        {
                                            "pos": {
                                                "line": 38,
                                                "col": 0
                                            },
                                            "text": "add_leaks"
                                        },
                                        {
                                            "pos": {
                                                "line": 39,
                                                "col": 0
                                            },
                                            "text": "The add instruction leaks timing information."
