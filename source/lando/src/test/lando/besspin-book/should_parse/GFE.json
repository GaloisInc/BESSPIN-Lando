                                                "line": 43,
                                                "col": 0
                                            },
                                            "text": ""
                                        },
                                        {
                                            "pos": {
                                                "line": 44,
                                                "col": 0
                                            },
                                            "text": "arithmetic_leaks"
                                        },
                                        {
                                            "pos": {
                                                "line": 45,
                                                "col": 0
                                            },
                                            "text": "All integer instructions leak timing information."
                                        }
                                    ]
                                },
