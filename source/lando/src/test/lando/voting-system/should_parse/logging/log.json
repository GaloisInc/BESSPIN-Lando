                        "col": 0
                    },
                    "name": "Secure System Log",
                    "abbrevName": null,
                    "inherits": [
                        [
                            "Secure Log"
                        ]
                    ],
                    "clientOf": [
                    ],
                    "explanation": "Must contain only system events. component System Entry inherit Log Entry Must only describe a system-level event related to hardware state changes.",
